import java.util.Scanner;

public class Main {
    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        System.out.print("Enter a decimal number: ");
        int n = sc.nextInt();

        decToBin(n);

    }
    static void decToBin(int n ){
        int myNumber = n;

     int finalNumber = 0;
     int power = 0;

     while (n > 0){

         int remainder = n % 2;
         finalNumber = finalNumber + (remainder * (int)Math.pow(10 , power));


         power++;
         n = n/2;
     }
        System.out.println("Binary number of "+myNumber+"  is: "+finalNumber);


    }
}
