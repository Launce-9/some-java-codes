import java.util.Arrays;
import java.util.Scanner;
import java.util.Random;

public class Main {


    public static void main(String[] args) {

        Random random = new Random();

        String otp = " ";

        for(int i = 1 ; i <= 6 ; i++){
            int digit = random.nextInt(10);
            otp += digit ;

        }
        System.out.println("Generate OTP:"+otp);
        

    }
}
